{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    // Local default so the API runs out-of-the-box on Windows: SQL Server
    // LocalDB ships with Visual Studio, needs no install, and runs the existing
    // SQL Server migrations as-is. On machines without LocalDB (e.g. macOS),
    // override via user-secrets or the ConnectionStrings__NotesDb env var.
    "NotesDb": "Server=(localdb)\\MSSQLLocalDB;Database=NotesApp;Trusted_Connection=True;MultipleActiveResultSets=true"
  }
}
