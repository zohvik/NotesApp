<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:NotesApp.Client.ViewModels"
             xmlns:models="clr-namespace:NotesApp.Core.Models;assembly=NotesApp.Core"
             x:Class="NotesApp.Client.MainPage"
             x:DataType="viewmodels:NotesViewModel"
             Title="Notes">

    <Grid ColumnDefinitions="280,*" Padding="10" ColumnSpacing="10">

        <CollectionView Grid.Column="0"
                         ItemsSource="{Binding Notes}"
                         SelectionMode="Single"
                         SelectedItem="{Binding SelectedNote}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Note">
                    <Grid Padding="10,8">
                        <Label Text="{Binding Title}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Column="1" Spacing="10">
            <Entry Placeholder="Title" Text="{Binding EditTitle}" FontSize="18" />
            <Editor Placeholder="Write your note..."
                    Text="{Binding EditBody}"
                    HeightRequest="350"
                    AutoSize="TextChanges" />

            <HorizontalStackLayout Spacing="10">
                <Button Text="New" Command="{Binding NewCommand}" />
                <Button Text="Save" Command="{Binding SaveCommand}" />
                <Button Text="Delete" Command="{Binding DeleteCommand}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

    </Grid>

</ContentPage>
